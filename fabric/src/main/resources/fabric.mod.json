{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}-mc${minecraftVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthor}"
  ],
  "contact": {
    "sources": "${modGitHub}"
  },
  "license": "${modLicense}",
  "icon": "assets/item_interactions_mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mineland.item_interactions_mod.fabric.client.Item_interactions_modFabricClient"
    ],
    "modmenu": ["dev.mineland.item_interactions_mod.fabric.client.ItemInteractionsModMenuApiImpl"]

  },  
  "mixins": [
    "item_interactions_mod.mixins.json",
    "fabricOnly.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "minecraft": "${minecraftVersion}",
    "fabric-api": "*",
    "java": ">=${javaVersion}"
  }
}
